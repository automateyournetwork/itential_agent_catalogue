# Copy to .env and fill in — .env is gitignored, never commit real values.
# See README.md "Setup" for what each of these is, where it's used, and how to find it.

# --- Itential Platform ---------------------------------------------------
# Used by every agents/Cisco/*/itential/agent.spec.md deployment recipe (Section 0).

PLATFORM_URL=https://your-instance.trial.itential.io
AUTH_METHOD=oauth
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# — or for local/password auth instead of oauth —
# AUTH_METHOD=password
# USERNAME=admin
# PASSWORD=admin

# The FlowAI project (namespace) you're deploying these agents into.
PROJECT_ID=your-project-id

# The cluster_id of a Gateway connected to this platform, registered with the
# catalyst-center MCP server's wrapper services (see mcp/INSTALL.md in any agent folder).
GATEWAY_CLUSTER=your-gateway-cluster-id

# --- Cisco Catalyst Center MCP server -------------------------------------
# Used by agents/Cisco/*/mcp/INSTALL.md when standing up the catalyst-center MCP server
# container. Separate from the Itential Platform above — this is the network controller
# the agents actually read from.

CATALYST_CENTER_HOST=https://your-catalyst-center-host
CATALYST_CENTER_USERNAME=your-read-only-username
CATALYST_CENTER_PASSWORD=your-password
CATALYST_CENTER_VERIFY_SSL=false

# Where the MCP server is reachable once it's up. Gateway-hosted wrapper services (which
# run inside Gateway's own container) need host.docker.internal, not localhost.
CATALYST_CENTER_MCP_URL=http://host.docker.internal:7001/v1/mcp
